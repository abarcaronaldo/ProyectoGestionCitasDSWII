{
  "info": {
    "name": "historial-medico-service - Atenciones (issue 4.6)",
    "description": "Coleccion Postman del flujo completo de historial-medico-service: reservar y atender una cita en citas-service, registrar la atencion clinica resultante, consultarla respetando 'ver solo lo propio', y los casos de error principales (400/403/404/409). Apunta directo a los microservicios (8084 y 8085) porque sus rutas de gateway todavia no existen (quedan para la issue 6.1). Las cabeceras X-User-Id/X-User-Rol se envian a mano simulando lo que el gateway propagara cuando se resuelva la issue 6.2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrlCitas", "value": "http://localhost:8084" },
    { "key": "baseUrlHistorial", "value": "http://localhost:8085" },
    { "key": "pacienteId", "value": "1" },
    { "key": "medicoId", "value": "1" },
    { "key": "especialidadId", "value": "1" },
    { "key": "citaId", "value": "" },
    { "key": "citaIdNoAtendida", "value": "" },
    { "key": "atencionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. [citas] Reservar cita a atender (PACIENTE) -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('citaId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "1" },
          { "key": "X-User-Rol", "value": "PACIENTE" }
        ],
        "url": "{{baseUrlCitas}}/api/citas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"especialidadId\": {{especialidadId}},\n  \"fechaHora\": \"2030-04-01T10:00:00\",\n  \"motivo\": \"Control postman historial\"\n}"
        }
      }
    },
    {
      "name": "2. [citas] Reservar segunda cita SIN atender -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('citaIdNoAtendida', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "1" },
          { "key": "X-User-Rol", "value": "PACIENTE" }
        ],
        "url": "{{baseUrlCitas}}/api/citas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"especialidadId\": {{especialidadId}},\n  \"fechaHora\": \"2030-04-02T10:00:00\",\n  \"motivo\": \"Cita que se queda RESERVADA\"\n}"
        }
      }
    },
    {
      "name": "3. [citas] Marcar asistencia de la primera cita (MEDICO) -> 200 ATENDIDA",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('estado ATENDIDA', () => pm.expect(pm.response.json().estado).to.eql('ATENDIDA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "5" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlCitas}}/api/citas/{{citaId}}/asistencia",
        "body": { "mode": "raw", "raw": "{\n  \"asistio\": true\n}" }
      }
    },
    {
      "name": "4. [historial] Registrar atencion (MEDICO) -> 201, pacienteId/medicoId resueltos del lado servidor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('atencionId', body.id);",
              "pm.test('pacienteId resuelto desde la cita', () => pm.expect(body.pacienteId).to.eql(Number(pm.collectionVariables.get('pacienteId'))));",
              "pm.test('medicoId resuelto desde la cita', () => pm.expect(body.medicoId).to.eql(Number(pm.collectionVariables.get('medicoId'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "5" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"citaId\": {{citaId}},\n  \"motivoConsulta\": \"Dolor de cabeza recurrente\",\n  \"diagnostico\": \"Cefalea tensional\",\n  \"tratamiento\": \"Paracetamol 500mg cada 8h por 3 dias\",\n  \"observaciones\": \"Control en 2 semanas si persiste\"\n}"
        }
      }
    },
    {
      "name": "5. [historial] Registrar atencion duplicada (misma cita) -> 409",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "5" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"citaId\": {{citaId}},\n  \"motivoConsulta\": \"Duplicado\",\n  \"diagnostico\": \"Duplicado\"\n}"
        }
      }
    },
    {
      "name": "6. [historial] Registrar atencion sobre cita NO atendida -> 409",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "5" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"citaId\": {{citaIdNoAtendida}},\n  \"motivoConsulta\": \"No deberia poder registrarse\",\n  \"diagnostico\": \"No deberia poder registrarse\"\n}"
        }
      }
    },
    {
      "name": "7. [historial] Registrar atencion con rol PACIENTE (no autorizado) -> 403",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "1" },
          { "key": "X-User-Rol", "value": "PACIENTE" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"citaId\": {{citaIdNoAtendida}},\n  \"motivoConsulta\": \"No deberia poder registrarse\",\n  \"diagnostico\": \"No deberia poder registrarse\"\n}"
        }
      }
    },
    {
      "name": "8. [historial] Obtener atencion como el propio paciente -> 200",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "1" },
          { "key": "X-User-Rol", "value": "PACIENTE" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/{{atencionId}}"
      }
    },
    {
      "name": "9. [historial] Obtener atencion como OTRO paciente -> 403",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "2" },
          { "key": "X-User-Rol", "value": "PACIENTE" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/{{atencionId}}"
      }
    },
    {
      "name": "10. [historial] Listar mis-atenciones como el medico que atendio -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('incluye la atencion creada', () => pm.expect(pm.response.json().some(a => a.id === Number(pm.collectionVariables.get('atencionId')))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "5" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/mis-atenciones"
      }
    },
    {
      "name": "11. [historial] Listar por medico ajeno (otro MEDICO) -> 403",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "6" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/medico/{{medicoId}}"
      }
    },
    {
      "name": "12. [historial] Actualizar atencion (el medico que la registro) -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('diagnostico actualizado', () => pm.expect(pm.response.json().diagnostico).to.eql('Cefalea tensional - mejorada'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "5" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/{{atencionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivoConsulta\": \"Dolor de cabeza recurrente\",\n  \"diagnostico\": \"Cefalea tensional - mejorada\",\n  \"tratamiento\": \"Suspender paracetamol\",\n  \"observaciones\": \"Alta\"\n}"
        }
      }
    },
    {
      "name": "13. [historial] Actualizar atencion (OTRO medico) -> 403",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "6" },
          { "key": "X-User-Rol", "value": "MEDICO" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/{{atencionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivoConsulta\": \"No deberia poder editar\",\n  \"diagnostico\": \"No deberia poder editar\"\n}"
        }
      }
    },
    {
      "name": "14. [historial] Listar todas las atenciones (RECEPCIONISTA) -> 200",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "7" },
          { "key": "X-User-Rol", "value": "RECEPCIONISTA" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones"
      }
    },
    {
      "name": "15. [historial] Eliminar atencion (ADMIN) -> 204",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-User-Id", "value": "9" },
          { "key": "X-User-Rol", "value": "ADMIN" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/{{atencionId}}"
      }
    },
    {
      "name": "16. [historial] Obtener atencion inexistente -> 404",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "9" },
          { "key": "X-User-Rol", "value": "ADMIN" }
        ],
        "url": "{{baseUrlHistorial}}/api/atenciones/999999"
      }
    }
  ]
}
