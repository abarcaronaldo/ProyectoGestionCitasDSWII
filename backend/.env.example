# OPCIONAL: no hace falta para arrancar. El docker-compose.yml ya trae estos
# mismos valores por defecto, así que "docker compose up --build" funciona sin .env.
# Crea un ".env" (copiando este archivo) SOLO si quieres personalizar contraseñas/claves.
# ".env" no se sube al repo (ver .gitignore).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esta-clave
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
JWT_SECRET=cambiar-esta-clave-jwt-en-produccion
CORS_ORIGINS=http://localhost:4200
